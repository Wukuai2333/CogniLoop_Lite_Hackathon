# CogniLoop Lite is local-first and BYOK.
# Copy this file to .env when you want to enable future AI features.

LLM_API_KEY=your_api_key_here

# Optional alias used by some provider tooling.
OPENAI_API_KEY=your_api_key_here

# Local demo setting for Cognee. Keep this local.
ENABLE_BACKEND_ACCESS_CONTROL=false
SYSTEM_ROOT_DIRECTORY=.cognee_system
DATA_ROOT_DIRECTORY=.data_storage
CACHE_ROOT_DIRECTORY=.cognee_cache
COGNEE_LOGS_DIR=.cognee_system/logs
